<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ShopList.Maui.ViewModels"
             xmlns:models="clr-namespace:ShopList.Maui.Models"
             x:Class="ShopList.Maui.Views.EditItemPage"
             Title="Detalles del articulo">
    
    <ContentPage.BindingContext>
        <viewmodels:EditItemViewModel/>
    </ContentPage.BindingContext>
    
    
    <Grid Padding="16"
          >
        <VerticalStackLayout VerticalOptions="Start"
                             Spacing="8">

            <Label Text="Nombre del articulo:"/>
            <Entry BackgroundColor="WhiteSmoke"
                   Placeholder="Ejemplo: Manzanas"/>
            
            <Label Text="Cantidad:"/>
            <Entry BackgroundColor="WhiteSmoke"
                   Text="1"/>

            <HorizontalStackLayout HorizontalOptions="End">

                <CheckBox />
                <Label Text="Comprado"
                       VerticalOptions="Center"/>

            </HorizontalStackLayout>
           
            <Button Text="Guardar"
                    Command="{Binding Path=SaveCommand}"
                    HorizontalOptions="Fill"
                    Margin="0, 24, 0, 0"/>

        </VerticalStackLayout>
    </Grid>

</ContentPage>